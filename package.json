{
  "name": "alphacode",
  "version": "0.1.0",
  "license": "MIT",
  "author": "James Bryan (JABSystems)",
  "private": true,
  "description": "AlphaCode by JABSystems - a local Windows terminal cockpit",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:main && node scripts/dev.cjs",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "tsc --noEmit -p tsconfig.json && npm run build:main && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke": "npm run build:main && electron dist-electron/electron/smoke.js",
    "package": "npm run build && electron-packager . AlphaCode --platform=win32 --arch=x64 --out=release --overwrite --icon=public/icon.ico --asar --asar.unpackDir=node_modules/node-pty --ignore=\"^/(work|workspaces|docs|tests|test-results|playwright-report|src|shared|electron|scripts|release)(/|$)\""
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "^0.577.0",
    "node-pty": "1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^1.5.4"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
